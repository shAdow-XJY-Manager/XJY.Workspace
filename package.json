{
  "name": "shadow-xjy-manager-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Super-repo for shAdow-XJY-Manager organization (multi-tech polyglot submodules)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "status": "node scripts/submodule-status.mjs",
    "health": "node scripts/check-submodule-health.mjs",
    "update:com": "git submodule update --remote --merge -- workspaces/com/**",
    "update:ent": "git submodule update --remote --merge -- workspaces/ent/**",
    "update:game": "git submodule update --remote --merge -- workspaces/game/**",
    "update:learn": "git submodule update --remote --merge -- workspaces/learn/**",
    "update:sys": "git submodule update --remote --merge -- workspaces/sys/**",
    "update:util": "git submodule update --remote --merge -- workspaces/util/**",
    "update:pages": "git submodule update --remote --merge -- pages/**",
    "update:all": "git submodule update --remote --merge",
    "push:submodules": "bash scripts/submodule-push.sh",
    "push:dry-run": "bash scripts/submodule-push.sh --dry-run",
    "build:web": "node scripts/build-web.mjs",
    "build:web:flutter": "node scripts/build-web.mjs --flutter-only",
    "build:web:vue": "node scripts/build-web.mjs --vue-only",
    "build:web:dry-run": "node scripts/build-web.mjs --dry-run",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:readme": "node scripts/check-readme-sync.mjs",
    "validate": "pnpm run check:workspace && pnpm run check:readme && pnpm run health",
    "tech:list": "node scripts/list-technologies.mjs",
    "tech:stats": "node scripts/list-technologies.mjs --stats"
  },
  "workspaceGroups": {
    "com": {
      "org/Community": "XJY.COM.ORG.Community",
      "org/Workers": "XJY.COM.ORG.Workers"
    },
    "ent": {
      "musi/musicListen": "XJY.ENT.MUSI.musicListen",
      "video/tv": "XJY.ENT.VIDEO.tv",
      "read/comicRead": "XJY.ENT.READ.comicRead",
      "read/novelRead": "XJY.ENT.READ.novelRead"
    },
    "game": {
      "comp/gameCenter": "XJY.GAME.COMP.gameCenter",
      "comp/world_flutter": "XJY.GAME.COMP.world_flutter",
      "comp/world_vue": "XJY.GAME.COMP.world_vue",
      "mario/superMario_QT": "XJY.GAME.MARIO.superMario_QT",
      "mini/findDifferencesGame": "XJY.GAME.MINI.findDifferencesGame",
      "mini/flipChess_flutter": "XJY.GAME.MINI.flipChess_flutter",
      "mini/parkourGame": "XJY.GAME.MINI.parkourGame",
      "mini/rockPaperScissors": "XJY.GAME.MINI.rockPaperScissors",
      "mini/snakeGame": "XJY.GAME.MINI.snakeGame",
      "mini/ticTacToe": "XJY.GAME.MINI.ticTacToe",
      "pvz/pvz_flutter": "XJY.GAME.PVZ.pvz_flutter"
    },
    "learn": {
      "be/backendService": "XJY.LEARN.BE.backendService",
      "be/sqlAPI": "XJY.LEARN.BE.sqlAPI",
      "be/sqlAPI2": "XJY.LEARN.BE.sqlAPI2",
      "fe/componentPassMessage_vue": "XJY.LEARN.FE.componentPassMessage_vue",
      "fe/filePass": "XJY.LEARN.FE.filePass",
      "fe/filePass2": "XJY.LEARN.FE.filePass2",
      "fe/jsCoding": "XJY.LEARN.FE.jsCoding",
      "fe/passData": "XJY.LEARN.FE.passData",
      "fe/routerTrain_vue": "XJY.LEARN.FE.routerTrain_vue",
      "fe/webpack": "XJY.LEARN.FE.webpack",
      "misc/learnDodgeTheCreeps_GoDot": "XJY.LEARN.learnDodgeTheCreeps_GoDot",
      "misc/xcodeProject": "XJY.LEARN.xcodeProject"
    },
    "sys": {
      "campus/campusPrice": "XJY.SYS.campusPrice",
      "crea/readingReader": "XJY.SYS.CREA.readingReader",
      "crea/writingWriter": "XJY.SYS.CREA.writingWriter",
      "second/secondHandHouse_flask": "XJY.SYS.secondHandHouse_flask",
      "trade/schoolSecondhandApp_flutter": "XJY.SYS.TRADE.schoolSecondhandApp_flutter",
      "trade/schoolSecondhandApp_springBoot": "XJY.SYS.TRADE.schoolSecondhandApp_springBoot"
    },
    "util": {
      "core/blurGlass": "XJY.UTIL.blurGlass",
      "core/clickTextField": "XJY.UTIL.clickTextField",
      "font/fontRegenerated": "XJY.UTIL.FONT.fontRegenerated",
      "font/fontToolExe": "XJY.UTIL.FONT.fontToolExe",
      "font/subFontPackage": "XJY.UTIL.FONT.subFontPackage",
      "core/listTwoLevel": "XJY.UTIL.listTwoLevel",
      "pac/flutter_common": "XJY.UTIL.PAC.FlutterCommon",
      "web/browserExtensions": "XJY.UTIL.WEB.browserExtensions",
      "web/customSearchPage": "XJY.UTIL.WEB.customSearchPage",
      "web/fakeBrowser": "XJY.UTIL.WEB.fakeBrowser",
      "web/websiteTools": "XJY.UTIL.WEB.websiteTools"
    },
    "pages": {
      "shadow-xjy-manager.github.io": "shadow-xjy-manager.github.io"
    }
  }
}
